// ============================================================
// SUDOKU  —  Pythia Pascal  —  Nomidor Software
// No Exit statements — all control flow uses boolean flags
// ============================================================

var
  WIN_W  : Integer;
  WIN_H  : Integer;
  CELL   : Integer;
  GRID_X : Integer;
  GRID_Y : Integer;
  GRID_W : Integer;

var
  board    : array of Integer;
  given    : array of Integer;
  solution : array of Integer;

var
  selRow    : Integer;
  selCol    : Integer;
  gameWon   : Boolean;
  gameMode  : Integer;
  elapsed   : Integer;
  lastSec   : Integer;
  wasDown   : Boolean;
  iniPath   : String;
  tickCount : Integer;
  hintsUsed : Integer;

// ===========================================================================
//  UTILITY
// ===========================================================================

function RC(r, c: Integer): Integer;
begin
  Result := r * 9 + c;
end;

function Pad2(n: Integer): String;
begin
  if n < 10 then Result := '0' + IntToStr(n)
  else            Result := IntToStr(n);
end;

function FmtTime(secs: Integer): String;
begin
  Result := Pad2(secs div 60) + ':' + Pad2(secs mod 60);
end;

// ===========================================================================
//  CONFLICT DETECTION — no Exit, uses boolean short-circuit
// ===========================================================================

function Conflicts(r, c, d: Integer): Boolean;
var
  i, br, bc, dr, dc, tr, tc : Integer;
begin
  Result := False;
  if d = 0 then
  begin
    Result := False;
  end
  else
  begin
    // Row check
    i := 0;
    while (i < 9) and (not Result) do
    begin
      if (i <> c) and (board[RC(r, i)] = d) then Result := True;
      i := i + 1;
    end;

    // Column check
    i := 0;
    while (i < 9) and (not Result) do
    begin
      if (i <> r) and (board[RC(i, c)] = d) then Result := True;
      i := i + 1;
    end;

    // Box check
    if not Result then
    begin
      br := (r div 3) * 3;
      bc := (c div 3) * 3;
      dr := 0;
      while (dr < 3) and (not Result) do
      begin
        dc := 0;
        while (dc < 3) and (not Result) do
        begin
          tr := br + dr;
          tc := bc + dc;
          if (tr <> r) or (tc <> c) then
            if board[RC(tr, tc)] = d then Result := True;
          dc := dc + 1;
        end;
        dr := dr + 1;
      end;
    end;
  end;
end;

// ===========================================================================
//  ITERATIVE BOARD FILLER — no Exit, no Break
// ===========================================================================

procedure FillBoard;
var
  order  : array of Integer;
  tryAt  : array of Integer;
  pos, i, j, tmp, digit : Integer;
  found  : Boolean;
begin
  SetLength(order, 81 * 9);
  SetLength(tryAt, 81);

  for pos := 0 to 80 do
  begin
    for i := 0 to 8 do order[pos * 9 + i] := i + 1;
    for i := 8 downto 1 do
    begin
      j   := Random(i + 1);
      tmp := order[pos * 9 + i];
      order[pos * 9 + i] := order[pos * 9 + j];
      order[pos * 9 + j] := tmp;
    end;
    tryAt[pos] := 0;
  end;

  pos := 0;
  while (pos >= 0) and (pos < 81) do
  begin
    found := False;
    while (tryAt[pos] < 9) and (not found) do
    begin
      digit := order[pos * 9 + tryAt[pos]];
      tryAt[pos] := tryAt[pos] + 1;
      if not Conflicts(pos div 9, pos mod 9, digit) then
      begin
        board[pos] := digit;
        found := True;
      end;
    end;

    if found then
      pos := pos + 1
    else
    begin
      board[pos] := 0;
      tryAt[pos] := 0;
      for i := 0 to 8 do order[pos * 9 + i] := i + 1;
      for i := 8 downto 1 do
      begin
        j   := Random(i + 1);
        tmp := order[pos * 9 + i];
        order[pos * 9 + i] := order[pos * 9 + j];
        order[pos * 9 + j] := tmp;
      end;
      pos := pos - 1;
    end;
  end;
end;

// ===========================================================================
//  PUZZLE GENERATOR
// ===========================================================================

procedure GeneratePuzzle(difficulty: Integer);
var
  toRemove, attempts, pos, i : Integer;
begin
  for i := 0 to 80 do board[i] := 0;
  FillBoard;
  for i := 0 to 80 do solution[i] := board[i];

  if difficulty = 1 then toRemove := 36
  else if difficulty = 2 then toRemove := 46
  else toRemove := 54;

  attempts := 0;
  while (toRemove > 0) and (attempts < 300) do
  begin
    pos := Random(81);
    if board[pos] <> 0 then
    begin
      board[pos] := 0;
      dec(toRemove);
    end;
    inc(attempts);
  end;

  for i := 0 to 80 do
    if board[i] <> 0 then given[i] := 1
    else                   given[i] := 0;
end;

// ===========================================================================
//  DAILY CHALLENGE
// ===========================================================================

procedure SeedFromDate;
var
  ds      : String;
  y, m, d : Integer;
  seed, i : Integer;
  waste   : Integer;
begin
  ds   := DateStr;
  y    := StrToInt(Copy(ds, 1, 4));
  m    := StrToInt(Copy(ds, 6, 2));
  d    := StrToInt(Copy(ds, 9, 2));
  seed := y * 10000 + m * 100 + d;
  Randomize;
  for i := 1 to (seed mod 997) + 1 do
    waste := Random(1000);
end;

// ===========================================================================
//  INI PERSISTENCE — no Exit
// ===========================================================================

procedure SaveBestTime(diff, secs: Integer);
var
  key : String;
  old : Integer;
begin
  if diff = 1 then key := 'Easy'
  else if diff = 2 then key := 'Medium'
  else if diff = 3 then key := 'Hard'
  else key := 'Daily';

  old := IniReadInt(iniPath, 'BestTimes', key, 99999);
  if secs < old then
    IniWriteInt(iniPath, 'BestTimes', key, secs);
end;

function LoadBestTime(diff: Integer): Integer;
var
  key : String;
begin
  if diff = 1 then key := 'Easy'
  else if diff = 2 then key := 'Medium'
  else if diff = 3 then key := 'Hard'
  else key := 'Daily';
  Result := IniReadInt(iniPath, 'BestTimes', key, 0);
end;

procedure SaveState;
var
  bline, gline, sline : String;
  i                   : Integer;
begin
  bline := '';
  gline := '';
  sline := '';
  for i := 0 to 80 do
  begin
    bline := bline + IntToStr(board[i]);
    gline := gline + IntToStr(given[i]);
    sline := sline + IntToStr(solution[i]);
  end;
  IniWriteStr(iniPath, 'LastGame', 'Board',    bline);
  IniWriteStr(iniPath, 'LastGame', 'Given',    gline);
  IniWriteStr(iniPath, 'LastGame', 'Solution', sline);
  IniWriteInt(iniPath, 'LastGame', 'Mode',     gameMode);
  IniWriteInt(iniPath, 'LastGame', 'Elapsed',  elapsed);
end;

function LoadState: Boolean;
var
  bstr, gstr, sstr : String;
  i                : Integer;
begin
  bstr := IniReadStr(iniPath, 'LastGame', 'Board',    '');
  gstr := IniReadStr(iniPath, 'LastGame', 'Given',    '');
  sstr := IniReadStr(iniPath, 'LastGame', 'Solution', '');

  if (Length(bstr) = 81) and (Length(gstr) = 81) and (Length(sstr) = 81) then
  begin
    for i := 0 to 80 do
    begin
      board[i]    := StrToInt(Copy(bstr, i + 1, 1));
      given[i]    := StrToInt(Copy(gstr, i + 1, 1));
      solution[i] := StrToInt(Copy(sstr, i + 1, 1));
    end;
    gameMode := IniReadInt(iniPath, 'LastGame', 'Mode',    1);
    elapsed  := IniReadInt(iniPath, 'LastGame', 'Elapsed', 0);
    Result   := True;
  end
  else
    Result := False;
end;

// ===========================================================================
//  WIN CHECK — no Exit
// ===========================================================================

function CheckWin: Boolean;
var i : Integer;
begin
  Result := True;
  i := 0;
  while (i < 81) and Result do
  begin
    if board[i] <> solution[i] then Result := False;
    i := i + 1;
  end;
end;

// ===========================================================================
//  DRAWING
// ===========================================================================

procedure DrawGrid;
var
  r, c, x, y, digit, i : Integer;
  isSel, isGiv, hasCon  : Boolean;
  s                     : String;
begin
  GfxColor('black');
  GfxFillRect(0, 0, WIN_W, WIN_H);

  for r := 0 to 8 do
  begin
    for c := 0 to 8 do
    begin
      x := GRID_X + c * CELL;
      y := GRID_Y + r * CELL;

      digit  := board[RC(r, c)];
      isSel  := (r = selRow) and (c = selCol);
      isGiv  := given[RC(r, c)] = 1;
      hasCon := (digit <> 0) and Conflicts(r, c, digit);

      if isSel then
        GfxColor('#003366')
      else if hasCon then
        GfxColor('#330000')
      else if isGiv then
        GfxColor('#141428')
      else
        GfxColor('#0a0a1a');
      GfxFillRect(x + 1, y + 1, CELL - 2, CELL - 2);

      if digit <> 0 then
      begin
        GfxSetFont(22, isGiv);
        if hasCon then       GfxColor('red')
        else if isSel then   GfxColor('cyan')
        else if isGiv then   GfxColor('white')
        else                 GfxColor('#7ec8e3');
        s := IntToStr(digit);
        GfxDrawText(x + 18, y + 14, s);
      end;
    end;
  end;

  for i := 0 to 9 do
  begin
    if (i mod 3) = 0 then GfxColor('white')
    else                  GfxColor('#333355');
    GfxDrawLine(GRID_X,          GRID_Y + i * CELL, GRID_X + GRID_W, GRID_Y + i * CELL);
    GfxDrawLine(GRID_X + i * CELL, GRID_Y,          GRID_X + i * CELL, GRID_Y + GRID_W);
  end;
end;

procedure DrawStatus;
var
  sy, best : Integer;
  mstr     : String;
begin
  sy := GRID_Y + GRID_W + 10;
  GfxColor('black');
  GfxFillRect(0, sy - 2, WIN_W, 56);

  if gameMode = 1 then mstr := 'EASY'
  else if gameMode = 2 then mstr := 'MEDIUM'
  else if gameMode = 3 then mstr := 'HARD'
  else mstr := 'DAILY  ' + DateStr;

  GfxSetFont(11, True);
  GfxColor('#9999bb');
  GfxDrawText(GRID_X, sy, mstr);

  GfxSetFont(14, True);
  if gameWon then GfxColor('lime')
  else            GfxColor('white');
  GfxDrawText(GRID_X + 190, sy, FmtTime(elapsed));

  best := LoadBestTime(gameMode);
  if best > 0 then
  begin
    GfxSetFont(11, False);
    GfxColor('#777788');
    GfxDrawText(GRID_X + 320, sy + 2, 'Best: ' + FmtTime(best));
  end;
end;

procedure DrawButtons;
var
  by, bh, bw, i, bx : Integer;
  lbl                : String;
  clr                : String;
begin
  by := GRID_Y + GRID_W + 44;
  bh := 36;
  bw := 108;

  for i := 0 to 3 do
  begin
    bx := GRID_X + i * 118;

    if i = 0 then begin lbl := 'Easy';   clr := '#1a472a'; end
    else if i = 1 then begin lbl := 'Medium'; clr := '#1a3a47'; end
    else if i = 2 then begin lbl := 'Hard';   clr := '#472a1a'; end
    else begin lbl := 'Daily'; clr := '#2e1a47'; end;

    GfxColor(clr);
    GfxFillRect(bx, by, bw, bh);
    GfxColor('#445566');
    GfxDrawRect(bx, by, bw, bh);
    GfxSetFont(13, True);
    GfxColor('white');
    GfxDrawText(bx + 20, by + 10, lbl);
  end;

  // Hint button — Easy mode only
  if (gameMode = 1) and (not gameWon) then
  begin
    GfxColor('#4a4a00');
    GfxFillRect(GRID_X + GRID_W - 64, GRID_Y - 34, 64, 26);
    GfxColor('#888800');
    GfxDrawRect(GRID_X + GRID_W - 64, GRID_Y - 34, 64, 26);
    GfxSetFont(11, True);
    GfxColor('yellow');
    GfxDrawText(GRID_X + GRID_W - 52, GRID_Y - 28, 'Hint');
  end;
end;

procedure DrawWin;
var cx, cy : Integer;
begin
  cx := GRID_X + 70;
  cy := GRID_Y + (GRID_W div 2) - 30;
  GfxSetFont(30, True);
  GfxColor('lime');
  GfxDrawText(cx, cy, 'SOLVED!');
  GfxSetFont(14, False);
  GfxColor('yellow');
  GfxDrawText(cx + 10, cy + 40, 'Time: ' + FmtTime(elapsed));
end;

procedure DrawAll;
begin
  DrawGrid;
  DrawStatus;
  DrawButtons;
  if gameWon then DrawWin;
  GfxShow;
end;

// ===========================================================================
//  HIT TESTING — no Exit
// ===========================================================================

function HitCell(px, py: Integer; var r, c: Integer): Boolean;
var gx, gy : Integer;
begin
  gx := px - GRID_X;
  gy := py - GRID_Y;
  if (gx >= 0) and (gy >= 0) and (gx < GRID_W) and (gy < GRID_W) then
  begin
    c      := gx div CELL;
    r      := gy div CELL;
    Result := True;
  end
  else
    Result := False;
end;

function HitButton(px, py: Integer): Integer;
var by, bh, bw, i, bx : Integer;
begin
  by := GRID_Y + GRID_W + 44;
  bh := 36;
  bw := 108;
  Result := 0;
  if (py >= by) and (py <= by + bh) then
  begin
    i := 0;
    while (i < 4) and (Result = 0) do
    begin
      bx := GRID_X + i * 118;
      if (px >= bx) and (px <= bx + bw) then
        Result := i + 1;
      i := i + 1;
    end;
  end;
end;

function HitHint(px, py: Integer): Boolean;
var hx, hy : Integer;
begin
  hx := GRID_X + GRID_W - 64;
  hy := GRID_Y - 34;
  Result := (gameMode = 1) and (not gameWon)
        and (px >= hx) and (px <= hx + 64)
        and (py >= hy) and (py <= hy + 26);
end;

// ===========================================================================
//  GIVE HINT
// ===========================================================================

procedure GiveHint;
var
  candidates : array of Integer;
  count, i, pick : Integer;
begin
  SetLength(candidates, 81);
  count := 0;
  for i := 0 to 80 do
    if (board[i] = 0) and (given[i] = 0) then
    begin
      candidates[count] := i;
      count := count + 1;
    end;

  if count > 0 then
  begin
    pick         := candidates[Random(count)];
    board[pick]  := solution[pick];
    given[pick]  := 1;
    inc(hintsUsed);
    selRow := pick div 9;
    selCol := pick mod 9;
  end;
end;

// ===========================================================================
//  START GAME
// ===========================================================================

procedure StartGame(difficulty: Integer);
var
  firstEmpty, fi : Integer;
begin
  gameMode  := difficulty;
  gameWon   := False;
  selRow    := -1;
  selCol    := -1;
  elapsed   := 0;
  lastSec   := -1;
  hintsUsed := 0;

  if difficulty = 4 then
  begin
    SeedFromDate;
    GeneratePuzzle(2);
  end
  else
  begin
    Randomize;
    GeneratePuzzle(difficulty);
  end;

  SaveState;

  // Seleciona automaticamente a primeira célula vazia
  firstEmpty := -1;
  fi := 0;
  while (fi < 81) and (firstEmpty = -1) do
  begin
    if given[fi] = 0 then firstEmpty := fi;
    fi := fi + 1;
  end;
  if firstEmpty >= 0 then
  begin
    selRow := firstEmpty div 9;
    selCol := firstEmpty mod 9;
  end;
end;

// ===========================================================================
//  MAIN
// ===========================================================================

var
  i, mx, my, btn, hr, hc : Integer;
  isDown, needDrw         : Boolean;
  key                     : String;
  fi2                     : Integer;

begin
  WIN_W  := 560;
  WIN_H  := 620;
  CELL   := 54;
  GRID_X := 28;
  GRID_Y := 40;
  GRID_W := 9 * CELL;

  iniPath := GetAppPath + 'sudoku.ini';

  SetLength(board,    81);
  SetLength(given,    81);
  SetLength(solution, 81);

  for i := 0 to 80 do
  begin
    board[i]    := 0;
    given[i]    := 0;
    solution[i] := 0;
  end;

  GfxOpen(WIN_W, WIN_H, 'Sudoku  —  Pythia');

  if not LoadState then
    StartGame(1);

  gameWon   := CheckWin;
  wasDown   := False;
  tickCount := 0;
  hintsUsed := 0;

  // Se o jogo foi carregado (não gerado), seleciona a primeira célula vazia
  if (selRow < 0) and (not gameWon) then
  begin
    fi2 := 0;
    while (fi2 < 81) and (selRow < 0) do
    begin
      if given[fi2] = 0 then
      begin
        selRow := fi2 div 9;
        selCol := fi2 mod 9;
      end;
      fi2 := fi2 + 1;
    end;
  end;

  DrawAll;

  while GfxRunning do
  begin
    Sleep(50);
    inc(tickCount);

    if not gameWon then
    begin
      if (tickCount mod 20) = 0 then
      begin
        inc(elapsed);
        if elapsed <> lastSec then
        begin
          lastSec := elapsed;
          DrawAll;
        end;
      end;
    end;

    mx     := GfxMouseX;
    my     := GfxMouseY;
    isDown := GfxMouseDown;

    if isDown and (not wasDown) then
    begin
      btn := HitButton(mx, my);
      if btn > 0 then
      begin
        StartGame(btn);
        DrawAll;
      end
      else if HitHint(mx, my) then
      begin
        GiveHint;
        SaveState;
        DrawAll;
      end
      else if (not gameWon) and HitCell(mx, my, hr, hc) then
      begin
        if given[RC(hr, hc)] = 0 then
        begin
          selRow := hr;
          selCol := hc;
        end
        else
        begin
          selRow := -1;
          selCol := -1;
        end;
        DrawAll;
      end;
    end;
    wasDown := isDown;

    while GfxKeyPressed do
    begin
      key     := GfxReadKey;
      needDrw := False;

      if (not gameWon) and (selRow >= 0) and (selCol >= 0) then
      begin
        if (key >= '1') and (key <= '9') then
        begin
          board[RC(selRow, selCol)] := StrToInt(key);
          needDrw := True;
          if CheckWin then
          begin
            gameWon := True;
            SaveBestTime(gameMode, elapsed);
            IniWriteStr(iniPath, 'LastGame', 'Board', '');
          end;
        end
        else if (key = 'BACK') or (key = 'DEL') or (key = '0') then
        begin
          board[RC(selRow, selCol)] := 0;
          needDrw := True;
        end
        else if key = 'UP'    then begin if selRow > 0 then dec(selRow); needDrw := True; end
        else if key = 'DOWN'  then begin if selRow < 8 then inc(selRow); needDrw := True; end
        else if key = 'LEFT'  then begin if selCol > 0 then dec(selCol); needDrw := True; end
        else if key = 'RIGHT' then begin if selCol < 8 then inc(selCol); needDrw := True; end;
      end
      else if key = 'ESC' then
      begin
        selRow  := -1;
        selCol  := -1;
        needDrw := True;
      end;

      if needDrw then
      begin
        SaveState;
        DrawAll;
      end;
    end;
  end;

  GfxClose;
end.
