    FBtnNew         : TButton;
    FBtnOpen        : TButton;
    FBtnSave        : TButton;
    FBtnSaveAs      : TButton;
    FBtnRun         : TButton;
    FBtnStop        : TButton;
    FBtnInsert      : TButton;
    FBtnNewProj     : TButton;
    FBtnOpenProj    : TButton;
    FBtnCloseProj   : TButton;
    FBtnRefresh     : TButton;
    FLabelFile      : TLabel;

    // Left tree (project + examples + recent)
