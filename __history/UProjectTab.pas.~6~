// ---------------------------------------------------------------------------
//  Snippet popup menu
// ---------------------------------------------------------------------------
procedure TProjectTab.BuildSnippetMenu;
var
  I        : Integer;
  Item     : TMenuItem;
  Sep      : TMenuItem;
begin
  FSnippetMenu := TPopupMenu.Create(FOuterPanel);

  for I := 0 to High(SNIPPETS) do
  begin
    if (I = 8) or (I = 12) or (I = 14) then
    begin
      Sep := TMenuItem.Create(FSnippetMenu);
      Sep.Caption := '-';
      FSnippetMenu.Items.Add(Sep);
    end;

    Item         := TMenuItem.Create(FSnippetMenu);
    Item.Caption := SNIPPETS[I].Name;
    Item.Tag     := I;
    Item.OnClick := OnSnippetClick;
    FSnippetMenu.Items.Add(Item);
  end;

  FEditor.PopupMenu := FSnippetMenu;
end;

// ---------------------------------------------------------------------------
//  Project file context menu (Open / Set as Main / Rename / Delete)
// ---------------------------------------------------------------------------
procedure TProjectTab.BuildProjectFileMenu;
var
  RootItem : TMenuItem;

  procedure AddItem(const Cap: string; H: TNotifyEvent);
  var M: TMenuItem;
  begin
    M := TMenuItem.Create(FProjFileMenu);
    M.Caption := Cap;
    M.OnClick := H;
    FProjFileMenu.Items.Add(M);
  end;

  procedure AddSep;
  var M: TMenuItem;
  begin
    M := TMenuItem.Create(FProjFileMenu);
    M.Caption := '-';
    FProjFileMenu.Items.Add(M);
  end;

begin
  FProjFileMenu := TPopupMenu.Create(FOuterPanel);
  AddItem('New File...',       OnProjMenuNew);
  AddSep;
  AddItem('Open',              OnProjMenuOpen);
  AddItem('Set as Main File',  OnProjMenuSetMain);
  AddSep;
  AddItem('Rename...',         OnProjMenuRename);
  AddItem('Delete...',         OnProjMenuDelete);

  // Smaller menu shown when right-clicking the "Project: X" root node
  // (no file is "targeted" there, so most actions don't apply)
  FProjRootMenu := TPopupMenu.Create(FOuterPanel);
  RootItem := TMenuItem.Create(FProjRootMenu);
  RootItem.Caption := 'New File...';
  RootItem.OnClick := OnProjMenuNew;
  FProjRootMenu.Items.Add(RootItem);
end;

procedure TProjectTab.InsertSnippet(const Body: string; CaretFromEnd: Integer);
var
  StartPos : Integer;
begin
  StartPos := FEditor.SelStart;
  FEditor.SelText   := Body;
  FEditor.SelStart  := StartPos + Length(Body) - CaretFromEnd;
  FEditor.SelLength := 0;
  SetModified(True);
  FEditor.SetFocus;
end;

procedure TProjectTab.OnSnippetClick(Sender: TObject);
var
  Idx : Integer;
begin
  Idx := (Sender as TMenuItem).Tag;
  if (Idx >= 0) and (Idx <= High(SNIPPETS)) then
    InsertSnippet(SNIPPETS[Idx].Body, SNIPPETS[Idx].CaretFromEnd);
end;

procedure TProjectTab.OnInsertClick(Sender: TObject);
var
  P : TPoint;
begin
  P := FBtnInsert.ClientToScreen(Point(0, FBtnInsert.Height));
  FSnippetMenu.Popup(P.X, P.Y);
end;

// ---------------------------------------------------------------------------
//  Build the tree:  [Project] + Recent + Examples
// ---------------------------------------------------------------------------
procedure TProjectTab.BuildTree;
var
  Cats     : TStringList;
  Cat      : string;
  CatNode  : TTreeNode;
  I        : Integer;
  Ex       : TExampleProject;
  ExNode   : TTreeNode;
begin
  FTree.Items.BeginUpdate;
  try
    FTree.Items.Clear;

    // ── PROJECT (only when one is open) ──────────────────────────────────
    if IsProjectOpen then
    begin
      FNodeProject := FTree.Items.Add(nil, 'Project: ' + FProjectName);
      FNodeProject.Data := Pointer(-4);
      RefreshProjectNode;
      FNodeProject.Expand(True);
    end
    else
      FNodeProject := nil;

    // ── RECENT FILES ─────────────────────────────────────────────────────
    FNodeRecent := FTree.Items.Add(nil, 'Recent Files');
    FNodeRecent.Data := Pointer(-1);
    RefreshRecentNode;

    // ── EXAMPLE PROJECTS ─────────────────────────────────────────────────
    FNodeExamples := FTree.Items.Add(nil, 'Example Projects');
    FNodeExamples.Data := Pointer(-2);

    Cats := FExamples.Categories;
    try
      for Cat in Cats do
      begin
        CatNode      := FTree.Items.AddChild(FNodeExamples, '  ' + Cat);
        CatNode.Data := Pointer(-3);

        for I := 0 to FExamples.Count - 1 do
        begin
          Ex := FExamples.Items(I);
          if Ex.Category = Cat then
          begin
            ExNode      := FTree.Items.AddChild(CatNode, '    ' + Ex.Name);
            ExNode.Data := Pointer(I);
          end;
        end;
        CatNode.Expand(False);
      end;
    finally
      Cats.Free;
    end;

    FNodeRecent.Expand(True);
    FNodeExamples.Expand(False);
  finally
    FTree.Items.EndUpdate;
  end;
end;

procedure TProjectTab.RefreshRecentNode;
var
  I    : Integer;
  Name : string;
  Node : TTreeNode;
begin
  while FNodeRecent.Count > 0 do
    FTree.Items.Delete(FNodeRecent.Item[0]);

  if FRecent.Files.Count = 0 then
  begin
    FTree.Items.AddChild(FNodeRecent, '  (none yet)').Data := Pointer(-99);
  end
  else
  begin
    for I := 0 to FRecent.Files.Count - 1 do
    begin
      Name := ExtractFileName(FRecent.Files[I]);
      Node := FTree.Items.AddChild(FNodeRecent, '  ' + Name);
      Node.Data := Pointer(-(100 + I));
    end;
  end;
end;

// ---------------------------------------------------------------------------
//  Rebuild the project subtree from FProjectFiles
// ---------------------------------------------------------------------------
procedure TProjectTab.RefreshProjectNode;
var
  I    : Integer;
  Name : string;
  Node : TTreeNode;
begin
  if FNodeProject = nil then Exit;

  while FNodeProject.Count > 0 do
    FTree.Items.Delete(FNodeProject.Item[0]);

  if FProjectFiles.Count = 0 then
  begin
    FTree.Items.AddChild(FNodeProject, '  (no .mdp files yet)').Data := Pointer(-99);
    Exit;
  end;

  for I := 0 to FProjectFiles.Count - 1 do
  begin
    Name := ExtractFileName(FProjectFiles[I]);
    // Main file gets a star prefix (the bold styling is applied in CustomDraw)
    if SameText(FProjectFiles[I], FProjectMain) then
      Node := FTree.Items.AddChild(FNodeProject, '  * ' + Name)
    else
      Node := FTree.Items.AddChild(FNodeProject, '    ' + Name);
    Node.Data := Pointer(-(200 + I));
  end;
end;

// ---------------------------------------------------------------------------
//  Scan the project folder for *.mdp files
// ---------------------------------------------------------------------------
procedure TProjectTab.LoadProjectFiles;
var
  Dir   : string;
  Files : TArray<string>;
  F     : string;
begin
  FProjectFiles.Clear;
  if FProjectFile = '' then Exit;

  Dir   := ExtractFilePath(FProjectFile);
  if not TDirectory.Exists(Dir) then Exit;
  Files := TDirectory.GetFiles(Dir, '*.mdp');
  for F in Files do
    FProjectFiles.Add(F);
  FProjectFiles.Sort;
end;

// ---------------------------------------------------------------------------
//  Custom draw — bold the main file in the project tree
// ---------------------------------------------------------------------------
procedure TProjectTab.OnTreeCustomDraw(Sender: TCustomTreeView; Node: TTreeNode;
  State: TCustomDrawState; var DefaultDraw: Boolean);
var
  Tag : NativeInt;
  Idx : Integer;
begin
  DefaultDraw := True;
  if Node = nil then Exit;
  Tag := NativeInt(Node.Data);
  if (Tag <= -200) and (Tag > -300) then
  begin
    Idx := -(Tag + 200);
    if (Idx >= 0) and (Idx < FProjectFiles.Count) and
       SameText(FProjectFiles[Idx], FProjectMain) then
      FTree.Canvas.Font.Style := [fsBold]
    else
      FTree.Canvas.Font.Style := [];
  end
  else
    FTree.Canvas.Font.Style := [];
end;

// ---------------------------------------------------------------------------
//  Right-click on tree: show project-file context menu if appropriate
// ---------------------------------------------------------------------------
procedure TProjectTab.OnTreeMouseDown(Sender: TObject; Button: TMouseButton;
  Shift: TShiftState; X, Y: Integer);
var
  Node : TTreeNode;
  Tag  : NativeInt;
  Idx  : Integer;
  P    : TPoint;
begin
  if Button <> mbRight then Exit;
  P    := FTree.ClientToScreen(Point(X, Y));
  Node := FTree.GetNodeAt(X, Y);

  // Right-clicked empty space — offer the project menu if a project is open
  if Node = nil then
  begin
    if IsProjectOpen then
    begin
      FProjMenuTargetPath := '';
      FProjRootMenu.Popup(P.X, P.Y);
    end;
    Exit;
  end;

  Tag := NativeInt(Node.Data);

  if (Tag <= -200) and (Tag > -300) then
  begin
    // Right-clicked an individual project file — full file menu
    Idx := -(Tag + 200);
    if (Idx >= 0) and (Idx < FProjectFiles.Count) then
    begin
      FProjMenuTargetPath := FProjectFiles[Idx];
      FTree.Selected      := Node;
      FProjFileMenu.Popup(P.X, P.Y);
    end;
  end
  else if Tag = -4 then
  begin
    // Right-clicked the "Project: X" root node — just offer New File
    FProjMenuTargetPath := '';
    FTree.Selected      := Node;
    FProjRootMenu.Popup(P.X, P.Y);
  end
  else if IsProjectOpen then
  begin
    // Right-clicked some other node (Recent / Examples) while a project
    // is open — still offer the project menu so New File is always reachable
    FProjMenuTargetPath := '';
    FProjRootMenu.Popup(P.X, P.Y);
  end;
end;

// ---------------------------------------------------------------------------
//  Title bar / file label
// ---------------------------------------------------------------------------
procedure TProjectTab.UpdateTitleBar;
var
  Title : string;
begin
  if FCurrentFile <> '' then
    Title := ExtractFileName(FCurrentFile)
  else
    Title := 'Untitled.mdp';

  if FModified then Title := '* ' + Title;

  if FProjectName <> '' then
    Title := '[' + FProjectName + ']  ' + Title;

  FLabelFile.Caption := Title;
end;

procedure TProjectTab.SetModified(Val: Boolean);
begin
  FModified := Val;
  UpdateTitleBar;
end;

function TProjectTab.ConfirmDiscard: Boolean;
begin
  if not FModified then begin Result := True; Exit; end;
  Result := MessageDlg(
    'You have unsaved changes. Discard them?',
    mtConfirmation, [mbYes, mbNo], 0) = mrYes;
end;

procedure TProjectTab.LoadFile(const Path: string);
begin
  if not TFile.Exists(Path) then
  begin
    ShowMessage('File not found: ' + Path);
    Exit;
  end;
  FEditor.Lines.Text := TFile.ReadAllText(Path, TEncoding.UTF8);
  FCurrentFile       := Path;
  FModified          := False;
  FRecent.Add(Path);
  RefreshRecentNode;
  UpdateTitleBar;
  FOutput.Clear;
end;

procedure TProjectTab.SaveFile(const Path: string);
var
  WasNewToProject : Boolean;
begin
  WasNewToProject := IsProjectOpen and
                     SameText(ExtractFilePath(Path),
                              ExtractFilePath(FProjectFile)) and
                     (FProjectFiles.IndexOf(Path) < 0);

  TFile.WriteAllText(Path, FEditor.Lines.Text, TEncoding.UTF8);
  FCurrentFile := Path;
  FModified    := False;
  FRecent.Add(Path);
  RefreshRecentNode;

  // If the saved file is in the project folder, refresh the tree
  if WasNewToProject then
  begin
    LoadProjectFiles;
    RefreshProjectNode;
  end;
  UpdateTitleBar;
end;

// ---------------------------------------------------------------------------
//  Run the source currently in the editor (used by Run-currently-edited)
// ---------------------------------------------------------------------------
procedure TProjectTab.RunCurrentSource;
var
  Lex   : TLexer;
  Par   : TParser;
  Prog  : TProgramNode;
  T0    : Cardinal;
begin
  if Assigned(FInterp) then Exit;

  FOutput.Clear;
  FOutput.Lines.Add('Running...');
  T0 := GetTickCount;

  try
    Lex := TLexer.Create(FEditor.Lines.Text);
    try
      Lex.Tokenise;
      Par := TParser.Create(Lex.Tokens);
      try
        Prog := Par.Parse;
        try
          FInterp := TInterpreter.Create(Prog, FOutput.Lines);
          try
            FOutput.Lines.Clear;
            FInterp.SourceText := FEditor.Lines.Text;
            if FCurrentFile <> '' then
              FInterp.SourcePath := ExtractFilePath(FCurrentFile)
            else
              FInterp.SourcePath := GetCurrentDir;
            FInterp.Run;
            FOutput.Lines.Add('');
            FOutput.Lines.Add(Format('─── Done  (%d ms) ───', [GetTickCount - T0]));
          finally
            FInterp.Free;
            FInterp := nil;
          end;
        finally
          Prog.Free;
        end;
      finally
        Par.Free;
      end;
    finally
      Lex.Free;
    end;
  except
    on E: Exception do
    begin
      FOutput.Lines.Add('');
      FOutput.Lines.Add('*** ' + E.Message);
    end;
  end;
end;

// ---------------------------------------------------------------------------
//  Run the project main file (Delphi-style: F5 = run main, not run current)
//
//  Auto-saves the currently-being-edited file first so library edits aren't
//  lost when running. Then loads the main file's source from disk and runs
//  it through the interpreter with SourcePath set so the uses clause can
//  resolve sibling .mdp files.
// ---------------------------------------------------------------------------
procedure TProjectTab.RunProjectMain;
var
  Lex   : TLexer;
  Par   : TParser;
  Prog  : TProgramNode;
  T0    : Cardinal;
  MainSrc : string;
begin
  if Assigned(FInterp) then Exit;

  // Auto-save the current file if it's part of the project
  if (FCurrentFile <> '') and FModified and
     (FProjectFiles.IndexOf(FCurrentFile) >= 0) then
    SaveFile(FCurrentFile);

  if (FProjectMain = '') or (not TFile.Exists(FProjectMain)) then
  begin
    ShowMessage('Project main file not set or not found.' + sLineBreak +
                'Right-click a file in the tree and choose "Set as Main File".');
    Exit;
  end;

  MainSrc := TFile.ReadAllText(FProjectMain, TEncoding.UTF8);

  FOutput.Clear;
  FOutput.Lines.Add('Running project main: ' + ExtractFileName(FProjectMain));
  T0 := GetTickCount;

  try
    Lex := TLexer.Create(MainSrc);
    try
      Lex.Tokenise;
      Par := TParser.Create(Lex.Tokens);
      try
        Prog := Par.Parse;
        try
          FInterp := TInterpreter.Create(Prog, FOutput.Lines);
          try
            FOutput.Lines.Clear;
            FInterp.SourceText := MainSrc;
            FInterp.SourcePath := ExtractFilePath(FProjectMain);
            FInterp.Run;
            FOutput.Lines.Add('');
            FOutput.Lines.Add(Format('─── Done  (%d ms) ───', [GetTickCount - T0]));
          finally
            FInterp.Free;
            FInterp := nil;
          end;
        finally
          Prog.Free;
        end;
      finally
        Par.Free;
      end;
    finally
      Lex.Free;
    end;
  except
    on E: Exception do
    begin
      FOutput.Lines.Add('');
      FOutput.Lines.Add('*** ' + E.Message);
    end;
  end;
end;

// ---------------------------------------------------------------------------
//  Write the .mdproj file from the current state
// ---------------------------------------------------------------------------
procedure TProjectTab.WriteProjectIni;
var
  Ini : TIniFile;
begin
  if FProjectFile = '' then Exit;
  Ini := TIniFile.Create(FProjectFile);
  try
    Ini.WriteString('Project', 'Name',     FProjectName);
    Ini.WriteString('Project', 'MainFile', ExtractFileName(FProjectMain));
  finally
    Ini.Free;
  end;
end;

// ---------------------------------------------------------------------------
//  Change the project's main file
// ---------------------------------------------------------------------------
procedure TProjectTab.SetMainFile(const Path: string);
begin
  if not TFile.Exists(Path) then Exit;
  FProjectMain := Path;
  WriteProjectIni;
  RefreshProjectNode;
  UpdateTitleBar;
end;

// ---------------------------------------------------------------------------
//  Close the current project (back to standalone editing)
// ---------------------------------------------------------------------------
procedure TProjectTab.CloseProject;
begin
  if not ConfirmDiscard then Exit;
  FProjectFile := '';
  FProjectName := '';
  FProjectMain := '';
  FProjectFiles.Clear;
  FEditor.Lines.Text := NEW_SOURCE;
  FCurrentFile := '';
  FModified    := False;
  BuildTree;
  UpdateTitleBar;
  FOutput.Clear;
  FOutput.Lines.Add('Project closed.');
end;

